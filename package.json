{
  "name": "planeador-docente",
  "productName": "Planeador Docente",
  "version": "1.11.0",
  "description": "Sistema de planeación docente para educación básica y media (Colombia, grados 1.° a 11.°)",
  "main": "main.js",
  "author": "Planeador Docente",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "appId": "co.planeador.docente",
    "productName": "Planeador Docente",
    "files": [
      "main.js",
      "preload.js",
      "exportar-word.js",
      "ia.js",
      "src/**/*",
      "package.json",
      "build/icon.png",
      "actualizaciones.js",
      "servidor-aula.js",
      "pagina-movil.js"
    ],
    "win": {
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Planeador Docente",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "PlaneadorDocente-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PlaneadorDocente-portable-${version}.exe"
    },
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "soydarwinruiz",
        "repo": "planeador-docente"
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "docx": "^9.16.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
