{
  "name": "planeador-docente",
  "productName": "Tiza",
  "version": "2.2.2",
  "description": "Tiza: planeador y asistente del docente para educación básica y media (Colombia, grados 1.° a 11.°)",
  "main": "main.js",
  "author": "DocenTech",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node tests/estatico.js && node tests/ia-reintentos.js && node tests/e2e.js && node tests/e2e-funciones.js && node tests/e2e-completo.js && node tests/e2e-productividad.js && node tests/e2e-v2.js && node tests/e2e-solidez.js && node tests/e2e-ia-malla.js",
    "test:estatico": "node tests/estatico.js",
    "test:robot": "node tests/robot.js",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "appId": "co.planeador.docente",
    "productName": "Tiza",
    "files": [
      "main.js",
      "preload.js",
      "almacen.js",
      "basedatos.js",
      "acceso.js",
      "pagina-celular.js",
      "pagina-celular.html",
      "exportar-word.js",
      "ia.js",
      "src/**/*",
      "package.json",
      "build/icon.png",
      "actualizaciones.js",
      "servidor-aula.js",
      "pagina-movil.js"
    ],
    "win": {
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Tiza",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Tiza-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Tiza-portable-${version}.exe"
    },
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "soydarwinruiz",
        "repo": "planeador-docente"
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "docx": "^9.16.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.1"
  }
}
